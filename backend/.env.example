# ============================================================
# SentinelGrid — Backend Environment Variables
# ============================================================
# DO NOT paste real values into this file.
# This file is safe to commit to GitHub because it contains
# only placeholder values.
#
# To use: copy this file to a NEW file called ".env"
# and fill in your real values there.
# The ".env" file is listed in .gitignore and will NOT
# be committed to GitHub.
# ============================================================

# --- Server ---
PORT=3001

# --- AWS Region ---
# Example: us-east-1
AWS_REGION=us-east-1

# --- AWS Credentials ---
# DO NOT hardcode these. They will be configured via the AWS CLI
# in a later step. These are shown here for documentation only.
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here

# --- Amazon DynamoDB ---
# The name of the DynamoDB table that stores incidents
DYNAMODB_TABLE_NAME=SentinelGridIncidents

# --- Amazon S3 ---
# The name of the S3 bucket that stores evidence files
S3_BUCKET_NAME=sentinelgrid-evidence

# --- Amazon SNS ---
# The ARN (Amazon Resource Name) of the SNS topic for alerts
# Example: arn:aws:sns:us-east-1:123456789012:SentinelGridAlerts
SNS_TOPIC_ARN=arn:aws:sns:REGION:ACCOUNT_ID:SentinelGridAlerts

# --- Feature Flags ---
# Set to "true" only after AWS resources are created and configured.
# When "false", the app runs entirely on local mock data.
USE_AWS=false

# ============================================================
# Ring Developer API — Account Linking Configuration
# ============================================================
# DO NOT paste real values into this file.
# Copy to .env and fill in your real values there.
# The .env file is in .gitignore and will NOT be committed.
#
# Obtain credentials from the Ring Developer Portal:
#   https://developer.amazon.com/ring/console/apps
#
# Credentials are shown ONCE when you create your app — save them immediately.
#
# Ring Developer Console URL mapping:
#   Token Exchange URL → https://your-backend.example.com/ring/token-exchange
#   Account Link URL   → https://your-backend.example.com/ring/account-link
#   Webhook URL        → https://your-backend.example.com/ring/webhook
#   App Homepage URL   → https://your-frontend.example.com  (or /ring/home)
# ============================================================

# Client ID — included in token exchange calls to oauth.ring.com
RING_CLIENT_ID=

# Client Secret — authenticates token requests (backend only, never expose to frontend)
RING_CLIENT_SECRET=

# HMAC Signature Key — used to:
#   1. Verify incoming webhook X-Signature headers (hex encoding)
#   2. Compute/verify nonces during one-way account linking (Base64URL encoding)
# These are two different encodings of the same key — do not mix them.
RING_HMAC_SIGNATURE_KEY=

# Redirect URI — required for Partner-Initiated OAuth 2.0 only (invitation-only).
# Must exactly match the URI registered in the Ring Developer Portal.
# This is the full URL of the GET /ring/callback endpoint.
# Example: https://your-backend.example.com/ring/callback
# Leave blank if using the standard one-way (Ring-driven) flow only.
RING_REDIRECT_URI=

# Ring Amazon Vision API base URL
# Default: https://api.amazonvision.com (leave blank to use default)
RING_API_BASE_URL=

# App Homepage URL — where users are redirected after account linking completes.
# Set to the full URL of your SentinelGrid frontend dashboard.
# Example: https://your-frontend.example.com
# Default (local dev): http://localhost:5173
RING_APP_HOMEPAGE_URL=
